APP_ID=geo-platform
APP_SECRET=replace-with-long-random-secret
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/geo_platform
NODE_ENV=production
PORT=3000
# DeepGEO 自动查（维度四 · Open API）
DEEPGEO_MODE=sample
DEEPGEO_API_BASE=https://api.deepgeo.org.cn
DEEPGEO_AUTH_BASE=https://global-api.deepgeo.org.cn
# DEEPGEO_TOKEN_URL=https://global-api.deepgeo.org.cn/api/v1/token
DEEPGEO_ACCESS_TOKEN=
DEEPGEO_PHONE=
DEEPGEO_USER=
DEEPGEO_PASS=
# live 失败时韩后是否仍可用样例短路
DEEPGEO_ALLOW_SAMPLE_FALLBACK=0
DEEPGEO_USE_PLAYWRIGHT=0
