APP_ID=geo-platform
APP_SECRET=replace-with-long-random-secret
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/geo_platform
NODE_ENV=production
PORT=3000
# DeepGEO 自动查（维度四）
DEEPGEO_BASE_URL=https://www.deepgeo.org.cn
DEEPGEO_USER=
DEEPGEO_PASS=
# sample | live — sample 用韩后九格样例；live 需账号且走 XHR/Playwright
DEEPGEO_MODE=sample
# 可选：自定义登录/查询 API（站点 XHR）
# DEEPGEO_LOGIN_PATH=/api/login
# DEEPGEO_QUERY_PATH=/api/geo/query
# DEEPGEO_USE_PLAYWRIGHT=0
